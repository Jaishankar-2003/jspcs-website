{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jspcs-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "jaishankarpcservices2021@gmail.com",
    "NOTIFICATION_EMAIL": "jaishankarpcservices2021@gmail.com"
  }
}
